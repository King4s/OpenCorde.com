# Full configuration: render only BACKEND_IP, MEDIA_IP and TURN_DOMAIN.
# The pinned nginx image has built-in stream, ssl_preread and http_realip modules.
worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

stream {
    map $ssl_preread_server_name $tls_upstream {
        ${TURN_DOMAIN} ${MEDIA_IP}:5349;
        default 127.0.0.1:8444;
    }

    server {
        listen 8443;
        ssl_preread on;
        proxy_pass $tls_upstream;
        proxy_protocol on;
        proxy_connect_timeout 10s;
        proxy_timeout 3600s;
    }
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    # Room credentials are carried in signaling queries. Log only fixed route
    # classes and metrics; nginx's HTTP error messages can also include raw URIs.
    error_log /dev/null;
    map $uri $route_class {
        ~^/livekit(/|$) media;
        ~^/api/ api;
        /ws gateway;
        ~^/files(/|$) files;
        default web;
    }
    log_format opencorde '$time_iso8601 route=$route_class method=$request_method '
                         'status=$status upstream=$upstream_status seconds=$request_time';
    access_log /dev/stdout opencorde;
    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp;
    fastcgi_temp_path /tmp/fastcgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;
    scgi_temp_path /tmp/scgi_temp;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    server {
        # Only the local stream proxy can connect and supply the original client IP.
        listen 127.0.0.1:8444 ssl proxy_protocol;
        set_real_ip_from 127.0.0.1;
        real_ip_header proxy_protocol;
        server_name _;
        root /usr/share/nginx/html;
        index index.html;
        ssl_certificate /etc/opencorde/tls/fullchain.pem;
        ssl_certificate_key /etc/opencorde/tls/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        client_max_body_size 100m;
        server_tokens off;

        location /api/ {
            proxy_pass http://${BACKEND_IP}:3000;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header Forwarded "";
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 3600s;
            proxy_buffering off;
        }

        location = /ws {
            proxy_pass http://${BACKEND_IP}:3000;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header Forwarded "";
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 3600s;
        }

        location = /livekit {
            proxy_pass http://${MEDIA_IP}:7880/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 3600s;
        }
        location /livekit/ {
            proxy_pass http://${MEDIA_IP}:7880/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 3600s;
        }

        # Forward object requests to the private bucket; MinIO enforces access.
        # Legacy anonymous attachment display remains blocked. Deny bucket listing.
        location = /files { return 404; }
        location ~ ^/files/[^/]+/.+ {
            limit_except GET HEAD { deny all; }
            rewrite ^/files/(.*)$ /$1 break;
            proxy_pass http://${BACKEND_IP}:9000;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
        }
        location /files/ { return 404; }

        location = /sw.js {
            add_header Cache-Control "no-store" always;
            try_files $uri =404;
        }
        location = /index.html {
            add_header Cache-Control "no-store" always;
            try_files $uri =404;
        }
        location = /200.html {
            add_header Cache-Control "no-store" always;
            try_files $uri =404;
        }
        location / {
            add_header Cache-Control "no-store" always;
            try_files $uri $uri/ /200.html;
        }
    }
}
