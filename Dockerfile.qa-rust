# syntax=docker/dockerfile:1.7
# Disposable QA toolchain. Rust and OpenSSL headers stay inside this image.
FROM rust:1.99.1-bookworm@sha256:c9155318d07341301a78b45ecdd81af2e43b8b297d64e8fd4c5e80d7735607c3
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /qa/src
