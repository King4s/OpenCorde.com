# syntax=docker/dockerfile:1.7
# Disposable QA toolchain. Rust and OpenSSL headers stay inside this image.
FROM rust:1.97.1-bookworm@sha256:0e2bcaef56d041a486784e54104a81aebe0da44bd03019bd70bc0401e42e4a97
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /qa/src
