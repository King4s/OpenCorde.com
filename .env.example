# Production Compose. Prefer scripts/ops.py prepare to validate image digests
# and generate credentials. See docs/PHASE1_OPERATIONS.md.
COMPOSE_PROJECT_NAME=opencorde
DOMAIN=chat.example.org
# Separate DNS name on the same public IPv4; certificate covers both domains.
TURN_DOMAIN=turn.chat.example.org
PUBLIC_IP=203.0.113.10
BIND_IP=0.0.0.0
HTTPS_PORT=443
PRIVATE_SUBNET=172.30.90.0/24
BACKEND_IP=172.30.90.10
WEB_IP=172.30.90.20
MEDIA_IP=172.30.90.30

# Populate from release-images.json, including @sha256.
API_IMAGE=
WEB_IMAGE=
NETGUARD_IMAGE=
MINIO_IMAGE=

# Generated cryptographically by prepare; none has a usable default.
POSTGRES_PASSWORD=
JWT_SECRET=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
REGISTRATION_INVITE_CODE=
REGISTRATION_MODE=invite_only
ADMIN_USER_IDS=

# The private profile also fixes ALLOW_EXTERNAL_INTEGRATIONS=false.
# Application flags cannot bypass the namespace firewall.
PUBLIC_REGISTRY_SYNC=false
MEDIA_EGRESS=false
MEDIA_CLIENT_CIDRS=0.0.0.0/0
RTC_TCP_PORT=7881
# TURN/TLS shares public TCP 443 with HTTPS; internal 5349 is not published.
TURN_UDP_PORT=3478
